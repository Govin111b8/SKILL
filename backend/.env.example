NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillconnect
DB_USER=postgres
DB_PASSWORD=password
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# JWT
JWT_SECRET=your-secret-key-minimum-32-chars-long!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins (in production)
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Rate Limiting
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_API_MAX=200

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MIN=15

# Logging
LOG_LEVEL=debug

# ─── Redis (Sprint 1) ─────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# or use individual settings:
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=yourredispassword
# REDIS_TLS=false

# ─── Encryption (Sprint 1) ───────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=<64-char-hex-string>

# ─── Storage (Sprint 1) ──────────────────────────────────────────────────
STORAGE_PROVIDER=local  # 's3', 'r2', or 'local'
# AWS S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET=skillconnect-media
# Cloudflare R2:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=skillconnect-media
# R2_PUBLIC_URL=https://your-domain.r2.dev

# ─── SMS (Sprint 1 / Sprint 8) ───────────────────────────────────────────
SMS_PROVIDER=none  # 'msg91', 'twilio', or 'none'
# MSG91:
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=SKILCN
# MSG91_TEMPLATE_ID=
# Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ─── Face Match (Sprint 2) ───────────────────────────────────────────────
FACE_MATCH_PROVIDER=mock  # 'hyperverge', 'rekognition', or 'mock'
FACE_MATCH_MOCK_SCORE=92  # Score returned by mock provider (0-100)
# HyperVerge:
# HYPERVERGE_APP_ID=
# HYPERVERGE_APP_KEY=

# ─── KYC (Sprint 2) ──────────────────────────────────────────────────────
KYC_AUTO_VERIFY=false  # true = auto-verify in dev without admin review

# ─── Background Jobs (Sprint 3) ──────────────────────────────────────────
ENABLE_CRON=true  # Set 'false' to disable background jobs (e.g., in test)

# ─── Push Notifications (Sprint 8) ───────────────────────────────────────
# FCM_SERVER_KEY=
# FCM_PROJECT_ID=

# ─── Email (Sprint 8) ────────────────────────────────────────────────────
# SENDGRID_API_KEY=
EMAIL_FROM=noreply@skillconnect.in
APP_URL=http://localhost:3000

# ─── Payments (Sprint 6) ─────────────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── GST / Invoicing (Sprint 6) ──────────────────────────────────────────
# PLATFORM_GSTIN=27AAAAA0000A1Z5
# PLATFORM_STATE_CODE=27
# PLATFORM_LEGAL_NAME=SkillConnect Technologies Pvt Ltd
# PLATFORM_ADDRESS=Mumbai, Maharashtra, India 400001

# ─── Feature Flags (Sprint 10) ───────────────────────────────────────────
FEATURE_BOOKINGS=true
FEATURE_CHAT=true
FEATURE_DISPUTES=true
FEATURE_EMERGENCIES=false
FEATURE_WARRANTIES=false
FEATURE_AGENTS=false



# ─── Aadhaar OTP / eKYC (Sprint 12) ─────────────────────────────────────────
AADHAAR_OTP_PROVIDER=mock  # 'hyperverge' or 'mock'
# AADHAAR_OTP_BASE_URL=https://ind-docs.hyperverge.co/v2.0
# AADHAAR_MOCK_OTP=123456

# ─── WhatsApp (Sprint 12) ───────────────────────────────────────────────────
WHATSAPP_PROVIDER=none  # 'meta' or 'none'
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=

# ─── Meilisearch (Sprint 12) ────────────────────────────────────────────────
MEILI_ENABLED=false
MEILI_HOST=http://localhost:7700
# MEILI_MASTER_KEY=
MEILI_PROFESSIONALS_INDEX=professionals
MEILI_SERVICES_INDEX=services

# ─── AI Providers (Sprint 12) ───────────────────────────────────────────────
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ─── Observability (Sprint 12) ──────────────────────────────────────────────
# SENTRY_DSN=
