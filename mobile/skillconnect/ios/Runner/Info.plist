<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SkillConnect</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SkillConnect</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Portrait primary, landscape allowed -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Permission usage descriptions (required by App Store review) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SkillConnect uses your location to find nearby service professionals and show accurate service areas.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>SkillConnect uses your location in the background to provide live professional tracking during active bookings.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SkillConnect uses the microphone to record voice notes in chat and for Telugu/Hindi voice search.</string>
	<key>NSCameraUsageDescription</key>
	<string>SkillConnect uses the camera to upload your profile photo, portfolio images, and KYC documents.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SkillConnect accesses your photo library to upload profile photos, portfolio images, and booking evidence.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SkillConnect saves booking confirmations and receipts to your photo library.</string>
	<key>NSContactsUsageDescription</key>
	<string>SkillConnect accesses contacts to help you share referral codes with friends and family.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>SkillConnect uses Face ID for quick and secure login.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>SkillConnect uses speech recognition for voice search in Telugu and Hindi.</string>

	<!-- Background modes: push notifications + location for live tracking -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>location</string>
		<string>audio</string>
	</array>

	<!-- Universal Links (Associated Domains configured in Xcode entitlements) -->
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
</dict>
</plist>
